"--- Settings ---"

" Disable Vi-compatibility
se nocp

" Disable mouse
se mouse=

" Enable relative line numbers
se nu
se rnu

" Highlight 80th column
se cc=80

" Disable backup- and swapfiles
se nobk
se noswf

" Number of lines around cursor
se so=8

" File format and encoding
se ff=unix
se enc=utf-8

" Auto indents
se ai
se si

" Tab using spaces
se et

" Size of expanded tabs (real tabs are default)
se sts=2
se sw=2

" Wrap lines breaking by words
se wrap
se lbr

" Highlight search results
se hls

" Show number of search matches
se shm-=S

" Use 24-bit colors
se tgc

" Dark background
se bg=dark

" For corrent work in tmux
se term=xterm-256color

" viminfo file location
se vif=~/.local/share/vim/viminfo

"--- Plugins ---"

" Add custom directory to runtime path
se rtp+=~/.config/vim

" Begin Vim-Plug section
call plug#begin('~/.local/share/vim/plugged')

" Utils
Plug 'rstacruz/sparkup'
Plug 'tpope/vim-surround'

" Colorschemes
Plug 'morhetz/gruvbox'
Plug 'ayu-theme/ayu-vim'

" End Vim-Plug section
call plug#end()

"--- Colorscheme, highlighting, cursor ---"

" Colorscheme
colo ayu

" Transparent background
hi Normal guibg=NONE ctermbg=NONE

" Change cursor shape for different modes
let &t_SI = "\e[6 q"
let &t_SR = "\e[4 q"
let &t_EI = "\e[2 q"

"--- Netrw file explorer settings ---"

" Change history file location
let g:netrw_home = '~/.local/share/vim'

" Hide banner
let g:netrw_banner = 0

" Show tree instead of plain view
let g:netrw_liststyle = 3

" Split window when open file
let g:netrw_browse_split = 3

"--- Key mappings ---"

" Go to next or previous tab by L or H respectively
nn H gT
nn L gt

" Disable search highlighting
nn <space>h :noh<cr>
